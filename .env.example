# SMTP Configuration for Contact Form
# Required environment variables for the contact form to function properly

# SMTP server hostname (e.g., smtp.gmail.com)
SMTP_HOST=

# SMTP server port (commonly 465 for SSL, 587 for TLS)
SMTP_PORT=

# SMTP username (usually your email address)
SMTP_USER=

# SMTP password or app-specific password
SMTP_PASS=

# Whether to use SSL/TLS (true for port 465, false for port 587 with STARTTLS)
# If not set, defaults to true when port is 465
SMTP_SECURE=

# Email address to receive contact form submissions
CONTACT_TO=waybionics@gmail.com

# From address for contact form emails (optional)
# If not set, defaults to "Waybionic Website <SMTP_USER>"
CONTACT_FROM=
